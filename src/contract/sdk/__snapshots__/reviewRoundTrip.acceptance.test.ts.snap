exports[`reviewRoundTrip.acceptance given: [case1] a rules file and a target file on disk when: [t0] rhx review is invoked with a slug this behavior added then: the whole verdict reads as a caller would see it 1`] = `
"
🪨 run solid skill repo=bhrain/role=reviewer/skill=review

🦉 let's review
   ├─ brain: claude/sonnet/v5
